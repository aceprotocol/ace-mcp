{
  "name": "@ace-protocol/mcp",
  "version": "0.3.0",
  "description": "ACE Protocol hosted MCP service: a resident ACE agent runtime for clients that cannot run one",
  "type": "module",
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "eslint . && npm run typecheck:tests",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\""
  },
  "dependencies": {
    "@ace-protocol/sdk": "file:../sdk-ts",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "Apache-2.0"
}
